# Teams Bot
TEAMS_APP_ID=your-azure-bot-app-id
TEAMS_APP_SECRET=your-azure-bot-app-secret

# Admin / SePay
ADMIN_PASSWORD=changeme
SEPAY_WEBHOOK_SECRET=your-sepay-webhook-secret

# Bank (for the pay-now QR in reminder emails; keep in sync with client/.env)
BANK_CODE=MB
BANK_ACCOUNT=VQRQAJMOM6380
ACCOUNT_NAME=LUNCH TEAM

# Debt-reminder email — Friday 16:00 emails each debtor who has an email on file.
# Preferred: Microsoft Graph (Azure AD app, Mail.Send application permission).
# M365 tenants usually block basic-auth SMTP, so Graph is the reliable path.
GRAPH_TENANT_ID=your-directory-tenant-id
GRAPH_CLIENT_ID=your-app-client-id
GRAPH_CLIENT_SECRET=your-client-secret-value
GRAPH_SENDER=lunchtime@yourcompany.com

# SMTP fallback (only used if GRAPH_* unset; for non-M365 servers).
# If neither Graph nor SMTP is configured, the reminder is skipped (no error).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=lunchtime@yourcompany.com
SMTP_PASS=your-app-password
SMTP_FROM=LunchTime <lunchtime@yourcompany.com>

# MiniMax — AI food analyst (món lâu chưa ăn / gợi ý xoay tua).
# Anthropic-compatible endpoint, called via @anthropic-ai/claude-agent-sdk.
# Isolated to the server process (loaded from .env); do NOT put in ~/.claude/settings.json.
# If MINIMAX_API_KEY is empty, suggestions fall back to a deterministic text (no LLM).
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_KEY=your-minimax-api-token
